# Copy to /etc/deaf-navi-codex-app-server.env on the VPS and fill secrets there.
CODEX_APP_SERVER_HOST=127.0.0.1
CODEX_APP_SERVER_PORT=8789
CODEX_APP_SERVER_REQUIRE_TOKEN=1
CODEX_APP_SERVER_TOKEN=replace-with-long-random-token

# Use a current Codex model first, with stable fallbacks if the configured model is unavailable.
CODEX_APP_SERVER_MODELS=gpt-5.2-codex,gpt-5.1-codex,gpt-5-codex
CODEX_APP_SERVER_EXEC_TIMEOUT_MS=100000
CODEX_APP_SERVER_REQUEST_LIMIT_BYTES=768000
CODEX_APP_SERVER_MAX_BATCH_ITEMS=50
CODEX_APP_SERVER_EXPOSE_ERROR_DETAILS=0

# Codex CLI authentication. Keep this file readable only by the service user/root.
OPENAI_API_KEY=replace-with-openai-api-key

# Healthcheck defaults to /ready, which runs a tiny Codex self-test.
DEAF_NAVI_CODEX_HEALTHCHECK_DEEP=1
DEAF_NAVI_CODEX_HEALTHCHECK_TIMEOUT_SECONDS=90
