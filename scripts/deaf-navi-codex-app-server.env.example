# Copy to /etc/deaf-navi-codex-app-server.env on the VPS and fill secrets there.
CODEX_APP_SERVER_HOST=127.0.0.1
CODEX_APP_SERVER_PORT=8789
CODEX_APP_SERVER_REQUIRE_TOKEN=1
CODEX_APP_SERVER_TOKEN=replace-with-long-random-token

# Verify availability with the service account. Only explicitly listed models are attempted.
CODEX_APP_SERVER_MODELS=gpt-5.6-sol
CODEX_BIN=/srv/deaf-navi-codex-app-server/cli-0.153.4/node_modules/.bin/codex
CODEX_APP_SERVER_EXEC_TIMEOUT_MS=100000
CODEX_APP_SERVER_REQUEST_LIMIT_BYTES=768000
CODEX_APP_SERVER_MAX_BATCH_ITEMS=50
CODEX_APP_SERVER_EXPOSE_ERROR_DETAILS=0

# Production uses the service user's existing ChatGPT OAuth login, without an API key.
# Keep this file readable only by the service user/root. Do not add a billed API fallback.

# The periodic liveness check uses /health. /ready performs actual generation for recovery checks.
