# Copy to /etc/deaf-navi-codex-app-server.env on the VPS and fill secrets there.
CODEX_APP_SERVER_HOST=127.0.0.1
CODEX_APP_SERVER_PORT=8789
CODEX_APP_SERVER_REQUIRE_TOKEN=1
CODEX_APP_SERVER_TOKEN=replace-with-long-random-token

# Current production backend. Model and reasoning are defined once in
# complimentary-text-client.mjs; a current model-specific allowance is required.
DEAFNAVI_TEXT_BACKEND=complimentary
DEAFNAVI_OPENAI_KEY_FILE=/srv/deafnavi/shared/ai/shared-free-tier.key
DEAFNAVI_OPENAI_PROJECT_ID=replace-with-verified-shared-free-tier-project-id
DEAFNAVI_AI_STATE_DIR=/srv/deafnavi/shared/ai

# Legacy Codex settings apply only when an operator explicitly selects that backend.
# Without CODEX_APP_SERVER_MODELS, the CLI's configured default is used.
CODEX_BIN=/srv/deaf-navi-codex-app-server/cli-0.153.4/node_modules/.bin/codex
CODEX_APP_SERVER_EXEC_TIMEOUT_MS=100000
CODEX_APP_SERVER_REQUEST_LIMIT_BYTES=768000
CODEX_APP_SERVER_MAX_BATCH_ITEMS=50
CODEX_APP_SERVER_EXPOSE_ERROR_DETAILS=0

# Keep this file readable only by the service user/root.
# No paid API or Codex fallback when the complimentary backend is unavailable.

# The periodic liveness check uses /health. /ready performs actual generation for recovery checks.
