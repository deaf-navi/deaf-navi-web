deafnavi.com {
	root * /srv/deafnavi/current
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Cache-Control "public, max-age=300, must-revalidate"
	}

	@mutable path / *.html *.json *.xml /manifest.webmanifest /sw.js
	header @mutable Cache-Control "public, max-age=0, must-revalidate"

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.deafnavi.com {
	redir https://deafnavi.com{uri} permanent
}
