deafnavi.com {
    log deafnavi_access {
        hostnames deafnavi.com www.deafnavi.com
        output file /srv/deafnavi/shared/access-logs/access.log {
            mode 0640
            roll_size 10MiB
            roll_interval 24h
            roll_keep 31
            roll_keep_for 720h
            roll_uncompressed
        }
        format filter {
            wrap json
            fields {
                request>remote_ip delete
                request>remote_port delete
                request>client_ip delete
                request>headers delete
                request>tls delete
                request>uri regexp "[?].*$" ""
                resp_headers delete
                user_id delete
                err_id delete
                err_trace delete
                error delete
            }
        }
    }
    root * /srv/deafnavi/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
        Cache-Control "public, max-age=300, must-revalidate"
    }
    @mutable path / *.html *.json *.xml /manifest.webmanifest /sw.js
    header @mutable Cache-Control "public, max-age=0, must-revalidate"
    route {
        @private path /_backend /_backend/* *.php *.sqlite *.sqlite3 *.sql /connect/places /connect/places/* /connect/communities /connect/communities/*
        respond @private "Not Found" 404
        @directory path /admin /admin/* /submit /submit/* /connect/sign-cafe /connect/sign-cafe/* /directory-sitemap.xml
        handle @directory {
            request_body {
                max_size 64KB
            }
            header Cache-Control "private, no-store, max-age=0"
            header X-Frame-Options DENY
            rewrite * /_backend/index.php
            php_fastcgi unix//run/php/deafnavi.sock
        }
        file_server
    }
    handle_errors {
        rewrite * /404.html
        file_server
    }
}
www.deafnavi.com {
    redir https://deafnavi.com{uri} permanent
}
